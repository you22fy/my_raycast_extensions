{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "my-image-editor",
  "title": "my_image_editor",
  "description": "画像を読み込み、矩形・枠線・ボカシを入れて保存します",
  "icon": "icon.png",
  "author": "you22fy",
  "license": "MIT",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "my_image_editor",
      "title": "my_image_editor",
      "subtitle": "クリップボード / ファイル",
      "description": "画像を開いてマウス編集し、保存またはコピーします",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
