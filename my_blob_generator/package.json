{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "my-blob-generator",
  "title": "Blob Generator",
  "description": "Edges・Smoothness・カラーを指定してblob画像を生成します",
  "icon": "icon.png",
  "author": "you22fy",
  "license": "MIT",
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "my_blob_generator",
      "title": "Blob Generator",
      "subtitle": "PNG / SVG",
      "description": "blob画像を生成し、コピーまたは保存します",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
